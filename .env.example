# Copie para .env.local e preencha. NUNCA commite o .env.local.
#
# Convenção de arquivos locais (todos ignorados pelo git):
#   .env.local        -> ambiente ativo (hoje: HOMOLOGAÇÃO)
#   .env.local.prod   -> guardado de produção; só copiar para .env.local com aprovação
#   .env.local.homo   -> guardado de homologação (quando .env.local estiver em produção)

# homolog | local | production
# Obrigatório para db:migrate / db:seed (ver scripts/guard-db.ts).
APP_ENV=homolog

# URL do Postgres do Supabase (use o pooler, porta 6543, na Vercel)
DATABASE_URL=postgres://USUARIO:SENHA@HOST:6543/postgres

# Gere um valor diferente por ambiente: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Opcionais para o seed (obrigatórios quando a Fase 1 remover o padrão)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_DEFAULT_UNIT_CODE=00000
# SEED_DEFAULT_UNIT_NAME=Unidade Padrão
